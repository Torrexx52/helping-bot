BOT_TOKEN=
OWNER_TELEGRAM_ID=
GITHUB_TOKEN=
GH_SECRET_ESOTERIC=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8081
SYNC_INTERVAL_MIN=15
LOG_LEVEL=INFO
TZ=Europe/Moscow

# ---------- v2: поиск чатов и заявок (docs/spec-leads.md) ----------
# Пока TG_API_ID и TG_API_HASH пустые, юзербот выключен и бот работает как v1.

# my.telegram.org → API development tools, под ОТДЕЛЬНЫМ аккаунтом юзербота (не личным).
TG_API_ID=
TG_API_HASH=

# Любой OpenAI-совместимый API. Без ключа заявки приходят с пометкой «без проверки ИИ».
#   OpenRouter: https://openrouter.ai/api/v1   deepseek/deepseek-v4-flash:free  (запасная: deepseek/deepseek-v4-flash)
#   OpenAI:     https://api.openai.com/v1      gpt-4o-mini
#   DeepSeek:   https://api.deepseek.com       deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Необязательно: если основная модель ответила 429/5xx или таймаутом, запрос уходит в запасную.
LLM_FALLBACK_MODEL=
# Не больше стольких запросов в минуту к основной модели (очередь). 0 — без ограничения.
LLM_RPM=15
LLM_DAILY_LIMIT=300

# Приватный репозиторий данных; deploy key с правом записи лежит в data/ssh/leads-data.
LEADS_DATA_REPO=torrexx52/helping-bot-data

# Лимиты юзербота: вступлений в сутки и поисковых запросов за одну разведку.
JOIN_PER_DAY=15
SCOUT_QUERIES_PER_RUN=20
# Разведка по расписанию раз в сутки: «ЧЧ:ММ» (или cron «М Ч * * *»). Пусто — только по /scout.
SCOUT_CRON=
